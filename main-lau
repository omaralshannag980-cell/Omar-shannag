lastClickLabel.Parent = mainFrame

-- ============================================
-- 4. حلقة التحديث الرئيسية (RunService)
-- ============================================
local elapsedSinceLastClick = 0
local CLICK_INTERVAL = 600 -- 10 دقائق = 600 ثانية

RunService.RenderStepped:Connect(function(deltaTime)
    -- ------ تحديث المؤقت ------
    local totalSeconds = math.floor(tick() - startTime)
    local minutes = math.floor(totalSeconds / 60)
    local seconds = totalSeconds % 60
    timerLabel.Text = string.format("%02d:%02d", minutes, seconds)

    -- ------ التدرج اللوني (أسود ← أحمر ← أسود) ------
    -- نستخدم دالة الجيب لإنشاء تدرج سلس
    -- الفترة الكاملة للتدرج = 60 ثانية (30 للذهاب و30 للعودة)
    local cycleTime = (tick() % 60) / 60 -- قيمة بين 0 و 1
    local t = (math.sin(cycleTime * math.pi * 2 - math.pi / 2) + 1) / 2 -- قيمة بين 0 و 1

    -- حساب اللون: من الأسود (0,0,0) إلى الأحمر (1,0,0)
    local r = t
    local g = 0
    local b = 0
    mainFrame.BackgroundColor3 = Color3.new(r, g, b)

    -- ------ التحقق من وقت النقر ------
    elapsedSinceLastClick = elapsedSinceLastClick + deltaTime

    if elapsedSinceLastClick >= CLICK_INTERVAL then
        clickCenterScreen()
        elapsedSinceLastClick = 0 -- إعادة تعيين العداد
        lastClickLabel.Text = "آخر نقرة: " .. os.date("%H:%M:%S")
        print("[Anti-AFK] تم النقر في منتصف الشاشة")
    end
end)

