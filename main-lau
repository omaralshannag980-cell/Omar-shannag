-- ============================================
-- Anti-AFK Script for Roblox (Client-Side)
-- ============================================

-- الخدمات الأساسية
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")

-- المتغيرات الأساسية
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local startTime = tick() -- وقت بدء تشغيل السكربت

-- ============================================
-- 1. تعطيل حدث الطرد بسبب الخمول (Idled)
-- ============================================
-- الطريقة الأولى: محاولة تعطيل الاتصال مباشرة (تعمل مع بعض المنفذين)
local success, connections = pcall(function()
    return getconnections(LocalPlayer.Idled)
end)

if success and connections then
    for _, v in pairs(connections) do
        if v["Disable"] then
            v["Disable"](v)
        elseif v["Disconnect"] then
            v["Disconnect"](v)
        end
    end
else
    -- الطريقة الثانية: استخدام VirtualUser (تعمل دائمًا تقريبًا)
    local VirtualUser = game:GetService("VirtualUser")
    LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)
end

-- ============================================
-- 2. دالة النقر في منتصف الشاشة
-- ============================================
local function clickCenterScreen()
    local viewport = Camera.ViewportSize
    local centerX = viewport.X / 2
    local centerY = viewport.Y / 2
    
    -- محاكاة ضغطة زر الفأرة الأيسر (Down ثم Up)
    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
    task.wait(0.05) -- تأخير بسيط لمحاكاة نقر واقعي
    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
end

